{% set footer_content = landing_content.footer|default({}) %}
{% set clinic = landing_content.clinic|default({}) %}
{% set clinic_address = clinic.address|default({}) %}
{% set clinic_responsible = clinic.responsible|default({}) %}
{% set social_links = [
  {'href': facebook_url|default(''), 'icon': 'facebook', 'label': 'Facebook'},
  {'href': instagram_url|default(''), 'icon': 'instagram', 'label': 'Instagram'},
  {'href': whatsapp_url|default(''), 'icon': 'whatsapp', 'label': 'WhatsApp'}
] %}

<footer class="footer mt-5">
  <div class="container">
    <div class="footer-main">
      <div>
        <div class="footer-title">
          {{ app_name ?? 'Landing de saúde' }} - {{ footer_content.label|default('Atendimento') }}
        </div>

        <div class="footer-meta small">
          {% if clinic_address.street|default('') %}
            <address class="mb-0">
              {{ clinic_address.street }}{% if clinic_address.district|default('') %} — {{ clinic_address.district }}{% endif %}{% if clinic_address.city|default('') %}, {{ clinic_address.city }}{% if clinic_address.region|default('') %}/{{ clinic_address.region }}{% endif %}{% endif %}{% if clinic_address.postal_code|default('') %} · CEP {{ clinic_address.postal_code }}{% endif %}
            </address>
          {% else %}
            {{ footer_content.address|default('Atendimento presencial com horário agendado') }}<br>
          {% endif %}
          {% for hour in clinic.hours|default([]) %}
            {{ hour.label }}{% if hour.time|default('') %}, {{ hour.time }}{% endif %}<br>
          {% endfor %}
          {{ footer_content.meta|default('Consultas, check-ups e acompanhamento clínico') }}
        </div>

        {% if clinic_responsible.name|default('') %}
          <div class="footer-responsible small">
            {{ clinic_responsible.role|default('Responsável técnico') }}: <strong>{{ clinic_responsible.name }}</strong>
            {% if clinic_responsible.registry|default('') %} — <span class="footer-registry">{{ clinic_responsible.registry }}</span>{% endif %}
            {% if clinic_responsible.rqe|default('') %} · <span class="footer-registry">{{ clinic_responsible.rqe }}</span>{% endif %}
          </div>
        {% endif %}
      </div>

      <nav class="footer-social" aria-label="Redes sociais">
        {% for social in social_links %}
          {% if social.href and social.href != '#' %}
            <a class="footer-link" href="{{ social.href }}" target="_blank" rel="noopener noreferrer" aria-label="{{ social.label }}">
              <i class="bi bi-{{ social.icon }}"></i>
            </a>
          {% endif %}
        {% endfor %}
      </nav>
    </div>

    <div class="footer-note small">
      {{ footer_content.emergency_note|default('Atendimento eletivo. Em caso de urgência ou emergência, procure o pronto atendimento mais próximo.') }}
    </div>

    <div class="footer-bottom small">
      <span>© <span id="year">{{ "now"|date("Y") }}</span> — Todos os direitos reservados · <a class="footer-link-inline" href="{{ base_url }}/privacidade">Política de privacidade</a></span>

      {% if footer_content.credit|default('') %}
        <span class="footer-credit">{{ footer_content.credit|striptags('<a>')|raw }}</span>
      {% endif %}
    </div>
  </div>
</footer>

<button class="back-to-top btn btn-primary shadow" id="backToTop"
        aria-label="Voltar ao topo" title="Voltar ao topo">
  <i class="bi bi-chevron-up"></i>
</button>
